rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global lock
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth Helpers
    function isRealUser() { 
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; 
    }
    
    function isHardcodedSuperAdmin() {
      return isRealUser() && request.auth.token.email == 'andrezbuitrago82@gmail.com';
    }

    function isKnownAdmin() {
      return isHardcodedSuperAdmin() || (
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) && 
        get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.status == 'activo'
      );
    }
    
    function isSuperAdmin() {
      return isHardcodedSuperAdmin() || (
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) && 
        get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.role == 'SuperAdmin' &&
        get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.status == 'activo'
      );
    }

    // Admins Collection
    match /admins/{adminEmail} {
      // Allow anonymous users to read an admin doc during the first-time setup flow
      allow read: if request.auth != null;
      allow create: if request.auth != null && (isSuperAdmin() || adminEmail == 'andrezbuitrago82@gmail.com');
      allow update, delete: if isRealUser() && isSuperAdmin();
    }

    // Tenants Collection
    match /tenants/{tenantEmail} {
      allow read, write: if isRealUser() && isKnownAdmin();
    }
  }
}
